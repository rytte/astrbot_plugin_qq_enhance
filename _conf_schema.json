{
  "platform": {
    "type": "object",
    "description": "平台",
    "default": {},
    "items": {
      "platform_id": {
        "type": "string",
        "description": "限定的平台实例 ID",
        "hint": "留空时允许任意 aiocqhttp 实例；填写后只允许该实例。",
        "default": ""
      }
    }
  },
  "toolsets": {
    "type": "object",
    "description": "模型工具集",
    "default": {},
    "items": {
      "exposure_mode": {
        "type": "string",
        "description": "工具暴露模式",
        "default": "balanced",
        "options": ["compact", "balanced", "full"],
        "labels": ["精简", "平衡", "完整"]
      },
      "enabled_packs": {
        "type": "list",
        "description": "启用的能力包",
        "hint": "留空表示全部能力包。可填写 status、account、friend、group、message、media、file、request、web。",
        "default": []
      },
      "disabled_operations": {
        "type": "list",
        "description": "禁用的内部操作",
        "hint": "使用 tool.operation 格式，例如 qq_group_manage.leave。",
        "default": []
      }
    }
  },
  "permissions": {
    "type": "object",
    "description": "权限",
    "default": {},
    "items": {
      "allow_group_admin": {
        "type": "bool",
        "description": "允许当前群管理员操作当前群",
        "default": true
      },
      "allow_group_owner": {
        "type": "bool",
        "description": "允许当前群主操作当前群",
        "default": true
      },
      "allow_cross_group": {
        "type": "bool",
        "description": "允许 AstrBot 管理员跨群操作",
        "default": true
      },
      "allow_cross_private": {
        "type": "bool",
        "description": "允许 AstrBot 管理员跨好友操作",
        "default": true
      },
      "allow_cross_private_to_admin": {
        "type": "bool",
        "description": "允许普通用户跨会话私聊 AstrBot 管理员",
        "hint": "仅放宽 qq_send_message.send 的私聊目标；目标仍须是同平台的机器人好友，不允许跨群或临时会话。需同时开启跨会话消息衔接。",
        "default": false
      }
    }
  },
  "confirmation": {
    "type": "object",
    "description": "二次确认",
    "default": {},
    "items": {
      "ttl_seconds": {
        "type": "int",
        "description": "确认有效期（秒）",
        "default": 120,
        "minimum": 30,
        "maximum": 300
      },
      "operations": {
        "type": "list",
        "description": "需要二次确认的操作",
        "hint": "使用 tool.operation 格式；此列表是二次确认规则的唯一来源。",
        "default": [
          "qq_friend_manage.delete",
          "qq_group_files.rmdir",
          "qq_group_manage.avatar",
          "qq_group_manage.leave",
          "qq_group_manage.name",
          "qq_group_manage.whole_ban",
          "qq_group_member_manage.admin",
          "qq_group_member_manage.kick"
        ]
      }
    }
  },
  "request_notifications": {
    "type": "object",
    "description": "申请事件机器人通知",
    "default": {},
    "items": {
      "enabled": {
        "type": "bool",
        "description": "收到好友申请、入群申请或群邀请时由模型通知管理员",
        "default": false
      },
      "admin_user_ids": {
        "type": "list",
        "description": "接收机器人私聊通知的管理员 QQ 号",
        "hint": "必须填写字符串形式的 QQ 号，例如 [\"10001\", \"10002\"]；若需处理申请，账号必须已是 AstrBot 管理员，本列表不会授予管理员权限；开启通知时不能为空。",
        "default": []
      }
    }
  },
  "debounce": {
    "type": "object",
    "description": "消息防抖",
    "default": {},
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用消息防抖",
        "hint": "首条消息按等待窗口配置进入模型；同一会话、同一用户继续输入时，取消尚未执行工具或进入流式发送的生成，将前条完整输入保存为独立历史消息。支持所有能进入 AstrBot 本地 Agent 的 QQ 输入。",
        "default": true
      },
      "shared_group": {
        "type": "bool",
        "description": "群聊共用防抖",
        "hint": "开启后，同一群聊中不同用户的连续输入也会共用防抖；私聊仍按用户隔离。",
        "default": true
      },
      "initial_window_seconds": {
        "type": "float",
        "description": "首条消息等待窗口（秒）",
        "hint": "首条消息进入模型前的可选等待时间；0 表示立即进入。",
        "default": 0.0,
        "minimum": 0.0,
        "maximum": 60.0
      },
      "followup_window_seconds": {
        "type": "float",
        "description": "后续消息等待窗口（秒）",
        "hint": "已有请求收到后续消息时，取消旧请求前的可选等待时间；0 表示立即处理。",
        "default": 0.0,
        "minimum": 0.0,
        "maximum": 60.0
      },
      "max_wait_seconds": {
        "type": "float",
        "description": "一轮防抖累计最大等待时间（秒）",
        "hint": "只累计实际等待窗口，不计算模型、工具和网络耗时；0 表示不设累计上限。",
        "default": 5.0,
        "minimum": 0.0,
        "maximum": 300.0
      },
      "max_messages": {
        "type": "int",
        "description": "一批连续输入的最大条数",
        "hint": "达到限制后等待前批完成，再处理后续输入，不截断消息。",
        "default": 8,
        "minimum": 2,
        "maximum": 100
      },
      "max_buffer_mb": {
        "type": "int",
        "description": "允许续接的输入快照预算（MiB）",
        "hint": "包含图片、音频等编码后的内容；超过预算时保留前一请求，后续输入另行处理。",
        "default": 32,
        "minimum": 1,
        "maximum": 256
      },
      "ignore_prefixes": {
        "type": "list",
        "description": "不参与防抖的消息前缀",
        "hint": "空列表表示不按前缀排除；已经由命令或其他插件处理的消息仍沿用原流程。",
        "default": ["/", "!"]
      }
    }
  },
  "inbound": {
    "type": "object",
    "description": "入站消息语义化",
    "default": {},
    "items": {
      "semanticize_components": {
        "type": "bool",
        "description": "将 QQ 表情、语音转写和结构化组件转换为模型可读文本，如 [QQ component|QQ语音消息：转写文本]",
        "default": true
      },
      "enhance_voice_messages": {
        "type": "bool",
        "description": "使用 NapCat 语音识别作为回退",
        "hint": "仅在 AstrBot 未产生转写、消息仍为 Record 时调用 NapCat；支持顶层和引用语音。",
        "default": true
      },
      "component_spoof_protection": {
        "type": "object",
        "description": "QQ 组件文字防伪",
        "hint": "仅依据原始 OneBot 组件确认真实性；用户输入的保留格式 [QQ component|...] 会被明确标注。",
        "default": {},
        "items": {
          "enabled": {
            "type": "bool",
            "description": "启用 QQ 组件文字防伪",
            "hint": "开启前必须同时开启 inbound.semanticize_components。",
            "default": true
          },
          "verify_components": {
            "type": "bool",
            "description": "启用真实组件强验证",
            "hint": "开启后追加组件格式系统提示词和临时 qq_verified_components 可信标签；关闭时仅正则标记伪装文字。",
            "default": true
          },
          "protected_types": {
            "type": "list",
            "description": "需要防伪的 QQ 组件类型",
            "hint": "按此列表动态组装正则，verify_components开启时还按此列表验证真实结构。允许 red_packet、voice、dice、rps、poke、face、market_face、image、video、file、music、contact、location、share、json_card、miniapp、xml_card、forward、online_file、flash_transfer；防伪开启时不能为空。",
            "default": ["red_packet", "voice", "dice", "rps", "poke"]
          }
        }
      },
      "respond_to_poke": {
        "type": "bool",
        "description": "被戳一戳时允许唤醒模型回复",
        "hint": "仅处理 target_id 为机器人自身的 poke 通知。",
        "default": true
      },
      "respond_to_red_packet": {
        "type": "bool",
        "description": "识别到红包时允许唤醒模型回复",
        "hint": "NapCat 4.18.19 的 walletElement 识别要求网络适配器开启 debug。",
        "default": true
      },
      "mark_recalled_messages": {
        "type": "bool",
        "description": "在模型上下文中的 QQ 消息末尾标记该消息已被撤回",
        "hint": "支持私聊和群聊；只更新已有上下文，不会因撤回事件唤醒模型或主动回复。",
        "default": true
      },
      "max_semantic_chars": {
        "type": "int",
        "description": "单条消息追加的组件语义文本上限",
        "default": 2000,
        "minimum": 256,
        "maximum": 8000
      }
    }
  },
  "events": {
    "type": "object",
    "description": "事件记录",
    "default": {},
    "items": {
      "enabled_types": {"type": "list", "description": "需要记录的 OneBot 事件类型；留空表示全部支持的类型", "default": []},
      "retention_days": {"type": "int", "description": "事件保留天数", "default": 15, "minimum": 1, "maximum": 365}
    }
  },
  "audit": {
    "type": "object",
    "description": "审计",
    "default": {},
    "items": {
      "retention_days": {"type": "int", "description": "审计保留天数", "default": 30, "minimum": 7, "maximum": 365}
    }
  },
  "context_images": {
    "type": "object",
    "description": "图片历史轻量化",
    "default": {},
    "items": {
      "enabled": {"type": "bool", "description": "启用图片历史轻量化", "hint": "图片保存为历史上下文时替换为轻量引用；需要时模型可通过 qq_media.inspect 重新加载原图。", "default": true},
      "orphan_grace_days": {"type": "int", "description": "图片引用从历史消失后的自然日宽限天数", "default": 3, "minimum": 1, "maximum": 30},
      "retention_days": {"type": "int", "description": "原图最长保留自然日数", "hint": "按 AstrBot 所在主机的本地日期计算；0 表示关闭绝对保留期，孤儿与容量清理仍然生效。", "default": 30, "minimum": 0},
      "max_storage_mb": {"type": "int", "description": "会话原图总存储上限（MiB）", "hint": "空间不足时按本地自然日从最早日期开始整日淘汰，无论图片是否仍被会话历史引用。", "default": 2048, "minimum": 64, "maximum": 10240}
    }
  },
  "cross_session_handoff": {
    "type": "object",
    "description": "跨会话消息衔接",
    "default": {},
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用跨会话消息衔接",
        "hint": "跨会话发送成功后，将实际发送内容和来源说明写入目标会话历史，使后续交流能够自然承接；不会唤醒目标会话模型。",
        "default": true
      }
    }
  },
  "web_reader": {
    "type": "object",
    "description": "网页阅读",
    "default": {},
    "items": {
      "enabled": {"type": "bool", "description": "启用网页阅读", "hint": "关闭后隐藏并禁用本插件的三个网页工具，不影响内置搜索或 QQ 功能。", "default": true},
      "cache_ttl_seconds": {"type": "int", "description": "网页快照有效期（秒）", "default": 900, "minimum": 30, "maximum": 86400},
      "max_cached_pages": {"type": "int", "description": "最多缓存网页数", "default": 32, "minimum": 1, "maximum": 256},
      "max_cache_mb": {"type": "int", "description": "网页缓存上限（MiB）", "default": 16, "minimum": 1, "maximum": 128},
      "max_download_size_mb": {"type": "int", "description": "单页下载上限（MiB）", "hint": "与 network.max_download_size_mb 取较小值，按解压后的响应计量。", "default": 2, "minimum": 1, "maximum": 16},
      "max_text_chars": {"type": "int", "description": "单页正文字符上限", "default": 200000, "minimum": 1000, "maximum": 1000000},
      "max_concurrent_requests": {"type": "int", "description": "网页抓取与解析并发上限", "default": 2, "minimum": 1, "maximum": 8}
    }
  },
  "limits": {
    "type": "object",
    "description": "输出与消息限制",
    "default": {},
    "items": {
      "page_size": {"type": "int", "description": "默认页大小", "default": 20, "minimum": 1, "maximum": 100},
      "max_page_size": {"type": "int", "description": "最大页大小", "default": 100, "minimum": 1, "maximum": 200},
      "max_output_chars": {"type": "int", "description": "最大工具输出字符数", "default": 12000, "minimum": 1000, "maximum": 50000},
      "max_forward_nodes": {"type": "int", "description": "最大合并转发节点数", "default": 30, "minimum": 1, "maximum": 100},
      "max_forward_depth": {"type": "int", "description": "最大合并转发展开深度", "default": 3, "minimum": 1, "maximum": 5},
      "max_components": {"type": "int", "description": "单条消息最大组件数", "default": 30, "minimum": 1, "maximum": 100}
    }
  },
  "files": {
    "type": "object",
    "description": "文件安全",
    "default": {},
    "items": {
      "allowed_roots": {"type": "list", "description": "额外允许的绝对目录", "default": []},
      "max_file_size_mb": {"type": "int", "description": "本地文件上限（MiB）", "default": 100, "minimum": 1, "maximum": 2048},
      "max_base64_size_mb": {"type": "int", "description": "Base64 解码与单次图片重载上限（MiB）", "default": 10, "minimum": 1, "maximum": 100},
      "temp_ttl_seconds": {"type": "int", "description": "插件临时文件生命周期（秒）", "default": 21600, "minimum": 600, "maximum": 604800},
      "cleanup_interval_seconds": {"type": "int", "description": "临时文件清理间隔（秒）", "default": 600, "minimum": 60, "maximum": 86400}
    }
  },
  "network": {
    "type": "object",
    "description": "网络下载安全",
    "default": {},
    "items": {
      "allowed_domains": {"type": "list", "description": "允许的域名；留空表示不额外限制公网域名", "default": []},
      "blocked_domains": {"type": "list", "description": "禁止的域名", "default": []},
      "allow_private_network": {"type": "bool", "description": "允许访问私网地址", "default": false},
      "timeout_seconds": {"type": "int", "description": "下载总超时（秒）", "default": 30, "minimum": 3, "maximum": 180},
      "max_download_size_mb": {"type": "int", "description": "下载上限（MiB）", "default": 100, "minimum": 1, "maximum": 2048}
    }
  }
}
